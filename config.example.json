{
  "mode": "server",

  "natpierce": {
    "exe_path": "C:\\Tools\\natpierce\\natpierce.exe",
    "working_dir": "",
    "process_name": "natpierce",
    "start_args": ["-C"]
  },

  "api": {
    "url": "ws://127.0.0.1:33272/ws",
    "fallback_url": "ws://[::1]:33272/ws",
