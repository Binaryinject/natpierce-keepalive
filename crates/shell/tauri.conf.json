{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "natpierce-keepalive",
  "version": "0.1.2",
  "identifier": "com.binaryinject.natpierce-keepalive",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "natpierce-keepalive",
        "width": 880,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
